{
  "name": "awara-qa-automation",
  "version": "1.0.0",
  "private": true,
  "description": "QA automation home assignment: Playwright + TypeScript API and UI tests with Allure reporting",
  "type": "commonjs",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "playwright test",
    "test:api": "playwright test --project=api",
    "test:ui": "playwright test --project=ui",
    "test:smoke": "playwright test --grep @smoke",
    "test:quarantined": "RUN_QUARANTINED=1 playwright test --grep @quarantine",
    "docker:build": "docker build -t awara-qa-tests .",
    "test:docker": "npm run docker:build && docker run --rm --init --ipc=host -e BASE_URL -e API_URL -e UI_USER_AGENT -e API_USER_AGENT -v \"$PWD:/app\" -v /app/node_modules awara-qa-tests",
    "check:playwright-image": "node scripts/check-playwright-image.mjs",
    "test:scripts": "node --test scripts/*.test.mjs",
    "lint": "eslint . --max-warnings 0 && prettier --check .",
    "lint:fix": "eslint . --fix && prettier --write .",
    "typecheck": "tsc --noEmit",
    "report:html": "playwright show-report",
    "allure:generate": "node scripts/mark-known-bugs.mjs && allure generate allure-results -o allure-report --clean",
    "allure:open": "allure open"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.65.1",
    "@types/node": "^24.19.2",
    "allure": "^3.22.1",
    "allure-playwright": "^3.15.0",
    "dotenv": "^18.0.10",
    "eslint": "^10.15.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-playwright": "^2.12.2",
    "prettier": "^3.10.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.73.0",
    "zod": "^4.6.7"
  }
}
